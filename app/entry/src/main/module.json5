{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [{
      "name": "ohos.permission.NFC_TAG",
      "reason": "$string:nfc_reason",
      "usedScene": { "abilities": ["EntryAbility", "NfcDispatchAbility"], "when": "inuse" }
    }],
        "abilities": [{
      "name": "EntryAbility",
      "srcEntry": "./ets/entryability/EntryAbility.ets",
      "description": "$string:module_desc",
      "icon": "$media:layered_image",
      "label": "$string:app_name",
      "startWindowIcon": "$media:startIcon",
      "startWindowBackground": "$color:start_window_background",
      "exported": true,
      "skills": [
        { "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] },
        {
          // Fallback route for stickers: URI record nfclauncher://tag/<id> (App Linking mode).
          "entities": ["entity.system.browsable"],
          "actions": ["ohos.want.action.viewData"],
          "uris": [{ "scheme": "nfclauncher", "host": "tag" }]
        }
      ]
    }, {
      // Background NFC dispatch entry: started by the system NFC service when a tag
      // with a matching technology is discovered and no app holds foreground dispatch.
      "name": "NfcDispatchAbility",
      "srcEntry": "./ets/nfcability/NfcDispatchAbility.ets",
      "description": "$string:module_desc",
      "icon": "$media:layered_image",
      "label": "$string:dispatch_label",
      "startWindowIcon": "$media:startIcon",
      "startWindowBackground": "$color:start_window_background",
      "exported": true,
      "removeMissionAfterTerminate": true,
      "skills": [{
        "actions": ["ohos.nfc.tag.action.TAG_FOUND"],
        "uris": [
          { "type": "tag-tech/NfcA" },
          { "type": "tag-tech/NfcB" },
          { "type": "tag-tech/IsoDep" },
          { "type": "tag-tech/MifareClassic" },
          { "type": "tag-tech/NfcF" },
          { "type": "tag-tech/NfcV" }
        ]
      }]
    }]
  }
}
